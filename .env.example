# Variáveis das ferramentas de linha de comando (tools/). Modelo sem valores: pode ir ao GitHub.
# Copie para ".env" (que o .gitignore ignora) e preencha. Nunca coloque valores reais neste arquivo.
# O site (index.html e mestre.html) não lê nada daqui: a URL e a chave PÚBLICA do Supabase ficam em js/config.js.
#
# Use com:  node --env-file-if-exists=.env tools/migracao.js verificar ...
# ou pelos atalhos: npm run migracao -- verificar ...   |   npm run migrar-imagens

# Conexão do Postgres do Supabase (Project Settings > Database > Connection string, modo "Session").
# Usada por tools/migracao.js e tools/migrar-imagens.js.
SUPABASE_DB_URL=

# Caminho do certificado (.crt) baixado em Database > SSL Configuration, se o Node não confiar no TLS do Supabase.
SUPABASE_DB_CA=

# Chave secreta (sb_secret_...), só para tools/migrar-imagens.js --sim. Tem poder total sobre o projeto: guarde só no .env.
SUPABASE_SECRET_KEY=
